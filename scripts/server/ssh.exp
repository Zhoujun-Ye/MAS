# Password fallback when key login is unavailable. Load the protected .env first:
#   set -a; . ./.env; set +a; REMOTE_COMMAND='cd /home/zhoujunye/MAS-information && ls' expect scripts/server/ssh.exp
# Output stays visible; logging is off only while the password is sent.
set timeout 1800
log_user 1
spawn ssh -tt -p 22 zhoujunye@10.123.4.30 $env(REMOTE_COMMAND)
expect {
    -re "(?i)password:" {
        log_user 0
        send -- "$env(SERVER_SSH_PASSWORD)\r"
        log_user 1
        exp_continue
    }
    eof { catch wait result; exit [lindex $result 3] }
    timeout { puts "SSH timeout"; exit 2 }
}
