# Native CLIs read their own provider settings or inherited environment.
# This project does not load .env automatically. Keep real files private (0600).
# Set only the provider variables required by your separately configured CLI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Optional: password fallback for scripts/server/ssh.exp when key login is unavailable.
SERVER_SSH_PASSWORD=
